# user配置通过 GIT_AUTHOR_NAME、GIT_AUTHOR_EMAIL、GIT_COMMITTER_NAME、GIT_COMMITTER_EMAIL 设置

[alias]
	co = checkout
	cp = cherry-pick
[pull]
	rebase = false
[core]
	editor = nvim
  pager = delta
	excludesfile = ~/.gitignore_global
	ignorecase = false
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection
    side-by-side = true
[merge]
    conflictstyle = zdiff3
[http]
	sslVersion = tlsv1.2
[merge "mergiraf"]
	name = mergiraf
	driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L

