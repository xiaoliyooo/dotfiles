# user配置通过 GIT_AUTHOR_NAME、GIT_AUTHOR_EMAIL、GIT_COMMITTER_NAME、GIT_COMMITTER_EMAIL 设置

[init]
  defaultBranch = main
[diff]
  colorMoved = default 
  algorithm = histogram
[push]
  autoSetupRemote = true
[branch]
  sort = -committerdate
[column]
  ui = auto
[fetch]
  prune = true
[alias]
	co = checkout
	cp = cherry-pick
[pull]
	rebase = false
[core]
	editor = nvim
  pager = delta
	excludesfile = ~/.gitignore_global
	ignorecase = false
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    dark = true
    side-by-side = true
    syntax-theme = Visual Studio Dark+
    map-styles = "bold cyan => #0bf432"

    ; 文件头
    file-style = bold yellow ul
    file-decoration-style = none
    file-modified-label = "M"
    file-added-label = "A"
    file-removed-label = "D"
    file-renamed-label = "R"

    ; Hunk 头
    hunk-header-style = syntax bold
    hunk-header-decoration-style = none

    ; 行号格式（去掉边框）
    line-numbers-left-format = "{nm:>4} "
    line-numbers-right-format = "{np:>4} "
    line-numbers-minus-style = "#901010"
    line-numbers-plus-style = "#136000"
    line-numbers-zero-style = "#666666"
[merge]
    conflictstyle = zdiff3
[http]
	sslVersion = tlsv1.2
[merge "mergiraf"]
	name = mergiraf
	driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L
