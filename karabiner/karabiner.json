{
  "profiles": [
    {
      "complex_modifications": {
        "rules": [
          {
            "description": "Shift + Option + hjkl 全局滚动 (Vim 风格) - 排在 Ctrl+hjkl 方向键规则之前",
            "manipulators": [
              {
                "from": {
                  "key_code": "j",
                  "modifiers": {
                    "mandatory": ["left_shift", "left_option"],
                    "optional": ["any"]
                  }
                },
                "to": [{ "mouse_key": { "vertical_wheel": 64 } }],
                "type": "basic"
              },
              {
                "from": {
                  "key_code": "k",
                  "modifiers": {
                    "mandatory": ["left_shift", "left_option"],
                    "optional": ["any"]
                  }
                },
                "to": [{ "mouse_key": { "vertical_wheel": -64 } }],
                "type": "basic"
              },
              {
                "from": {
                  "key_code": "h",
                  "modifiers": {
                    "mandatory": ["left_shift", "left_option"],
                    "optional": ["any"]
                  }
                },
                "to": [{ "mouse_key": { "horizontal_wheel": -64 } }],
                "type": "basic"
              },
              {
                "from": {
                  "key_code": "l",
                  "modifiers": {
                    "mandatory": ["left_shift", "left_option"],
                    "optional": ["any"]
                  }
                },
                "to": [{ "mouse_key": { "horizontal_wheel": 64 } }],
                "type": "basic"
              }
            ]
          },
